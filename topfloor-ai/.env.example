# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and update with your actual values
# Never commit the .env file to version control
# ============================================================================

# Database Configuration
# PostgreSQL connection string for the authentication database
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://myuser:mypassword@localhost:5432/auth_db
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db

# JWT Security Configuration
# SECRET_KEY: Used to sign and verify JWT tokens (Requirement 4.1)
# IMPORTANT: Use a strong random secret key in production (minimum 32 characters)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use the default value in production!
SECRET_KEY=your-secret-key-here-use-strong-random-value-at-least-32-characters

# JWT Token Expiration
# ACCESS_TOKEN_EXPIRE_MINUTES: Duration in minutes before JWT tokens expire
# Default: 30 minutes (recommended for security)
# Adjust based on your security requirements (shorter = more secure, less convenient)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google ADK Configuration
# GOOGLE_API_KEY: API key for Google Gemini models
# Get your API key from: https://aistudio.google.com/app/apikey
# Required for agent execution
GOOGLE_API_KEY=your-google-api-key-here

# Model provider: "gemini", "groq", or "openai"
MODEL_PROVIDER=gemini

# Mock responses for rate limits (set to true to enable, false to disable)
# When enabled, the system will return mock responses when API rate limits are hit
# This allows testing all features without a paid API key
# Set to false when you have a paid API key to use real responses
USE_MOCK_RESPONSES=true

# Memory System Configuration - Chroma Cloud
# CHROMA_API_KEY: API key for Chroma Cloud
CHROMA_API_KEY=your-chroma-api-key-here

# CHROMA_TENANT: Tenant ID for Chroma Cloud
CHROMA_TENANT=733bcc53-ea72-4613-81b9-9f7baa2331a3

# CHROMA_DATABASE: Database name in Chroma Cloud
CHROMA_DATABASE=topfloor

# EMBEDDING_MODEL: Sentence transformer model for generating embeddings
# Default: all-MiniLM-L6-v2 (384 dimensions, fast and efficient)
# Other options: all-mpnet-base-v2 (768 dimensions, more accurate but slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MEMORY_ENABLED: Enable/disable long-term memory system
# Default: true
MEMORY_ENABLED=true

# Memory Pruning Settings
# MEMORY_PRUNE_DAYS: Delete memories older than this many days (if low importance)
# Default: 30 days
MEMORY_PRUNE_DAYS=30

# MEMORY_MIN_IMPORTANCE: Minimum importance score to keep during pruning (0-1)
# Default: 0.3
MEMORY_MIN_IMPORTANCE=0.3

# MEMORY_MAX_ACCESS_COUNT: Maximum access count for memories to be pruned
# Default: 2 (memories accessed 2 or fewer times may be pruned if old and low importance)
MEMORY_MAX_ACCESS_COUNT=2

# MEMORY_MAX_PER_USER: Maximum number of memories to keep per user
# Default: 1000
MEMORY_MAX_PER_USER=1000

# Redis Configuration
# REDIS_HOST: Redis Cloud hostname
REDIS_HOST=redis-12792.c274.us-east-1-3.ec2.cloud.redislabs.com

# REDIS_PORT: Redis Cloud port
REDIS_PORT=12792

# REDIS_USERNAME: Redis Cloud username (usually "default")
REDIS_USERNAME=default

# REDIS_PASSWORD: Redis Cloud password
REDIS_PASSWORD=cQidNJeKkIOwLGwGve2SVsGsK1rSA3ls

# REDIS_DB: Redis database number (0-15)
REDIS_DB=0

# REDIS_SSL: Use SSL/TLS for Redis connection (false for this Redis Cloud instance)
# Set to true if your Redis Cloud instance requires SSL
REDIS_SSL=false

# REDIS_URL: Alternative - provide full Redis URL (overrides above settings if set)
# Format for Redis Cloud: rediss://username:password@host:port/db
# Leave empty to use the component-based configuration above
REDIS_URL=

# Celery Configuration
# CELERY_BROKER_URL: Message broker URL for Celery task queue
# Leave empty to use Redis configuration above
CELERY_BROKER_URL=

# CELERY_RESULT_BACKEND: Result backend URL for Celery
# Leave empty to use Redis configuration above
CELERY_RESULT_BACKEND=

# Task Queue Settings
# TASK_MAX_RETRIES: Maximum number of retries for failed tasks
# Default: 3
TASK_MAX_RETRIES=3

# TASK_RETRY_DELAY: Delay in seconds between task retries
# Default: 60 seconds
TASK_RETRY_DELAY=60


# ============================================================================
# File Storage Configuration
# ============================================================================

# STORAGE_TYPE: Type of storage to use for artifacts (local or s3)
# Default: local
# Options:
#   - local: Store files on local filesystem
#   - s3: Store files on Amazon S3 or compatible service
STORAGE_TYPE=local

# LOCAL_STORAGE_PATH: Path for local file storage
# Default: ./storage/artifacts
# This directory will be created if it doesn't exist
LOCAL_STORAGE_PATH=./storage/artifacts

# ============================================================================
# S3 Storage Configuration (only needed if STORAGE_TYPE=s3)
# ============================================================================

# S3_BUCKET_NAME: Name of the S3 bucket for artifact storage
S3_BUCKET_NAME=your-bucket-name

# S3_REGION: AWS region for the S3 bucket
# Default: us-east-1
S3_REGION=us-east-1

# AWS_ACCESS_KEY_ID: AWS access key ID for S3 access
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS_SECRET_ACCESS_KEY: AWS secret access key for S3 access
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ============================================================================
# Signed URL Configuration
# ============================================================================

# SIGNED_URL_EXPIRY_SECONDS: Default expiry time for signed download URLs
# Default: 3600 (1 hour)
# Range: 60 seconds (1 minute) to 86400 seconds (24 hours)
SIGNED_URL_EXPIRY_SECONDS=3600

# API_BASE_URL: Base URL for the API (used in signed URLs)
# Default: http://localhost:8000
# In production, set this to your actual API domain (e.g., https://api.topfloor.ai)
API_BASE_URL=http://localhost:8000
